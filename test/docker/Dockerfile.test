# Clean-room test image. Network only at build (npm ci); tests run with --network none (test/docker/test.sh).
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-slim
RUN mkdir -p /app && chown node:node /app
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
# git is part of the product's evidence path (git refs, replay, the flows tour); node:*-slim ships without it, so
# the git tests would silently skip and the e2e/flows tiers could not run.
USER root
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
USER node
RUN npm ci --no-audit --no-fund
# npm ci resolves straight from package-lock.json, so it only ever caches yaml's TARBALL request, never its
# packument (the un-versioned "what versions exist" metadata) — but that's exactly what a fresh `npm install
# <tarball>` needs when it lands in a brand-new project with no lock file of its own (test/e2e/install/
# clean-install.test.ts). Network is available here, at build time; the test itself runs under --network none.
RUN npm view yaml@2.9.1 > /dev/null
COPY --chown=node:node . .
CMD ["sh", "-c", "npx tsc -p tsconfig.json --noEmit && npx vitest run --project unit --project contract --project golden && npm run build && npx vitest run --project install && npx vitest run --project cli && sh scripts/flows.sh && echo INSTALL OK"]
