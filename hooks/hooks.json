{
  "description": "MM3 nudge: one line, once per moment, before a helper is spawned and before a commit, merge, push or PR. Never blocks. A start-up message says so when MM3 runs from its self-contained build.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/launcher/mm3-launch\" hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/launcher/mm3-launch\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/launcher/mm3-launch\" session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
