#!/bin/sh
# mm3-launch: starts MM3 for the Claude Code plugin (plugin.json and hooks.json name this file; why it exists: launcher/README.md).
#   normal case : Node 22.13+ is present -> exec node bin/mm3.mjs mcp   (hook: exec node hooks/nudge.mjs; nothing is downloaded)
#   fallback    : Node missing, too old, or MM3 will not start on it -> use the self-contained MM3 build:
#                 a detached fetcher downloads it for this OS/CPU, checks its sha256 against checksums.json (generated by
#                 `npm run gen:checksums`, never edited), installs it and runs its `init`; this script then exec's `mm3 mcp`.
#                 Later starts find the installed file and fetch nothing.
#   slow fetch  : Claude Code gives an MCP server 30 s (MCP_TIMEOUT) to answer `initialize`. If the fetch is not done after
#                 20 s, this script answers the handshake itself ("installing") and, when the install finishes, starts the
#                 real server behind the same connection and sends tools/list_changed.
# Modes (first argument): mcp (default) | hook (PreToolUse nudge) | session-start (user-visible message) | fetch (internal)
# stdout belongs to the MCP protocol: every message goes to stderr. POSIX sh only; no Node, no Python.
# Test-only knobs (not documented anywhere else): MM3_TEST_RELEASE_URL replaces the download base (the pinned hash still
# decides), MM3_TEST_WAIT replaces the 20 s.

MIN_NODE=22.13     # the one place this launcher reads the Node floor; test/unit/launcher.test.ts fails if it differs from src/util/node-version.ts

MODE=${1:-mcp}
HERE=$(cd "$(dirname "$0")" && pwd)
SELF=$HERE/$(basename "$0")
ROOT=$(dirname "$HERE")
CHECKSUMS=$HERE/checksums.json
DATA=${CLAUDE_PLUGIN_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/mm3-plugin}
BINDIR=$HOME/.local/bin
INSTALLED=$BINDIR/mm3
MIN_MAJOR=${MIN_NODE%%.*}
MIN_MINOR=${MIN_NODE#*.}
WAIT=${MM3_TEST_WAIT:-20}

say() { printf 'mm3: %s\n' "$*" >&2; }
fail() { # fail <message> : in fetch mode also leaves the reason where the waiting launcher can read it
  printf 'mm3: ✖ %s\n' "$*" >&2
  [ "$MODE" = fetch ] && printf '%s\n' "$*" > "$DATA/install.err" 2>/dev/null
  exit 1
}

# ---- platform, checksums ----------------------------------------------------------------------------------
detect_platform() {
  os=$(uname -s 2>/dev/null); cpu=$(uname -m 2>/dev/null)
  case "$os" in
    Linux) OSK=linux;; Darwin) OSK=darwin;; MINGW*|MSYS*|CYGWIN*) OSK=win;; *) OSK=$os;;
  esac
  case "$cpu" in x86_64|amd64) CPUK=x64;; aarch64|arm64) CPUK=arm64;; *) CPUK=$cpu;; esac
  KEY=$OSK-$CPUK
  [ "$OSK" = win ] && INSTALLED=$BINDIR/mm3.exe
}
detect_platform
field() { # field <asset key> <field name>, from the one-line-per-asset checksums.json
  sed -n "s/.*\"$1\"[^{]*{\(.*\)}.*/\1/p" "$CHECKSUMS" | sed -n "s/.*\"$2\"[ ]*:[ ]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" | head -1
}
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | sed 's/.*= //'
  else return 1; fi
}
no_build() { fail "no self-contained MM3 build for $KEY yet ($NODE_WHY) → install Node.js $MIN_NODE or newer from https://nodejs.org, then restart Claude Code"; }
have_build() { [ -n "$(field "$KEY" file)" ] && [ -n "$(field "$KEY" sha256)" ]; }

# ---- Node check: sets NODE_WHY to a plain-words reason when Node cannot be used ---------------------------
NODE_WHY=
node_ok() { # node_ok [noprobe] : the probe (`node bin/mm3.mjs --version`) is skipped for the hook, which does not load the bundle
  NODE_WHY=
  if ! command -v node >/dev/null 2>&1; then NODE_WHY="Node.js is not installed"; return 1; fi
  v=$(node --version 2>/dev/null) || { NODE_WHY="Node.js is installed but does not run"; return 1; }
  v=${v#v}; maj=${v%%.*}; rest=${v#*.}; min=${rest%%.*}
  case "$maj$min" in ''|*[!0-9]*) NODE_WHY="could not read the Node.js version ($v)"; return 1;; esac
  if [ "$maj" -lt "$MIN_MAJOR" ] || { [ "$maj" -eq "$MIN_MAJOR" ] && [ "$min" -lt "$MIN_MINOR" ]; }; then
    NODE_WHY="Node.js v$v is older than the $MIN_NODE that MM3 needs"; return 1
  fi
  if [ "$1" != noprobe ] && ! node "$ROOT/bin/mm3.mjs" --version >/dev/null 2>&1; then NODE_WHY="MM3 would not start on Node.js v$v"; return 1; fi
  return 0
}

# a working real file at ~/.local/bin/mm3 (not npm's link)
installed_ok() { [ -f "$INSTALLED" ] && [ ! -L "$INSTALLED" ] && [ -x "$INSTALLED" ] && "$INSTALLED" --version >/dev/null 2>&1; }

download() { # download <url> <dest>; runs in the background so a signal can stop it
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 15 --speed-limit 1000 --speed-time 30 -o "$2" "$1" & DLPID=$!
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T 30 -O "$2" "$1" & DLPID=$!
  else
    return 127
  fi
  wait $DLPID
}

# ---- the fetch + verify + install + init (runs as `mm3-launch fetch`, detached from Claude Code) ---------
DLPID=
cleanup_fetch() { [ -n "$DLPID" ] && kill "$DLPID" 2>/dev/null; rm -f "$PART" 2>/dev/null; rm -rf "$DATA/.lock"; }
PART=
fetch_and_install() {
  ver=$(sed -n 's/.*"version"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$CHECKSUMS" | head -1)
  file=$(field "$KEY" file); want=$(field "$KEY" sha256); bytes=$(field "$KEY" bytes)
  have_build || no_build
  [ "$OSK" = win ] && fail "this is the POSIX launcher; on Windows the plugin runs launcher/mm3-launch.ps1"
  base=${MM3_TEST_RELEASE_URL:-$(sed -n 's/.*"base"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$CHECKSUMS" | head -1)}
  [ -n "$base" ] || fail "launcher/checksums.json names no download address → reinstall the plugin"
  url=$base/$file
  mkdir -p "$DATA" || fail "cannot create $DATA → check the folder is writable"
  # one fetcher at a time (session-start prefetch and the MCP start both ask for one): mkdir is atomic
  if ! mkdir "$DATA/.lock" 2>/dev/null; then
    holder=$(cat "$DATA/.lock/pid" 2>/dev/null)
    if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then say "a fetch is already running (pid $holder)"; exit 0; fi
    rm -rf "$DATA/.lock"; mkdir "$DATA/.lock" 2>/dev/null || fail "cannot take the install lock in $DATA"
  fi
  echo $$ > "$DATA/.lock/pid"
  rm -f "$DATA/install.ok" "$DATA/install.err" 2>/dev/null
  for old in "$DATA/$file".part.*; do [ -e "$old" ] && rm -f "$old"; done
  trap 'cleanup_fetch' EXIT; trap 'cleanup_fetch; exit 143' INT TERM HUP
  if installed_ok; then echo "$INSTALLED" > "$DATA/install.ok"; exit 0; fi
  PART=$DATA/$file.part.$$
  say "downloading the self-contained MM3 $ver for $KEY (about $((bytes / 1048576)) MB) from $base"
  t0=$(date +%s)
  if ! download "$url" "$PART"; then
    rm -f "$PART"
    fail "could not download $url → check your internet connection (or proxy) and restart Claude Code; nothing was installed. Or install Node.js $MIN_NODE+ and restart"
  fi
  got=$(sha256_of "$PART") || { rm -f "$PART"; fail "no sha256 tool found (sha256sum, shasum or openssl) → install one; nothing was installed"; }
  if [ "$got" != "$want" ]; then
    rm -f "$PART"
    fail "the download does not match the checksum pinned in this plugin (expected $want, got $got) → NOT installed. Do not use it; reinstall the plugin or report this at https://github.com/mvp-scale/mm3/issues"
  fi
  say "checked: sha256 matches the value pinned in the plugin ($(($(date +%s) - t0))s)"
  chmod 755 "$PART"      # GitHub's release download and Actions artifacts drop the execute bit, so it is set here
  mv -f "$PART" "$DATA/$file" || { rm -f "$PART"; fail "could not place the file in $DATA → check the folder is writable"; }
  # same end state as a normal install (~/.local/bin/mm3, config record), no key prompt. Run from $HOME so it never
  # touches a project folder; --no-claude because this plugin is already installed (we are running from it).
  if (cd "$HOME" && "$DATA/$file" init --no-claude --no-key --yes </dev/null >"$DATA/init.log" 2>&1); then
    say "installed: $INSTALLED (set up by 'mm3 init --no-key', details in $DATA/init.log)"
    sed -n '/is not on PATH/q1' "$DATA/init.log" || say "note: $BINDIR is not on your PATH; add it to your shell profile to type 'mm3' yourself"
    rm -f "$DATA/$file"      # init made its own copy; keep one big file, not two
    echo "$INSTALLED" > "$DATA/install.ok"
  else
    sed 's/^/mm3: init: /' "$DATA/init.log" >&2
    say "warning: 'mm3 init' reported a problem (lines above); running from $DATA/$file for this session"
    echo "$DATA/$file" > "$DATA/install.ok"
  fi
  : > "$DATA/first-run-pending"
}

# ---- the waiting launcher ---------------------------------------------------------------------------------
fetcher_alive() { p=$(cat "$DATA/.lock/pid" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
start_fetcher() {
  mkdir -p "$DATA"; : > "$DATA/fetch.log"
  if command -v setsid >/dev/null 2>&1; then setsid sh "$SELF" fetch </dev/null >>"$DATA/fetch.log" 2>&1 &
  else nohup sh "$SELF" fetch </dev/null >>"$DATA/fetch.log" 2>&1 &
  fi
}
next_steps() {
  say "what I did: used the self-contained MM3 because $NODE_WHY."
  say "next: MM3 runs now without a key (sample answers). For real answers add your TypeSafe key: in Claude Code run /plugin, choose MM3, Configure; or run 'mm3 doctor' in a terminal (add $BINDIR to PATH if it is not there)."
}

# ---- stub MCP server used only while a slow install finishes, then hands over to the real one -------------
jid() { printf '%s' "$1" | sed -n 's/.*"id"[ ]*:[ ]*\("[^"]*"\|[0-9][0-9]*\).*/\1/p'; }
jmethod() { printf '%s' "$1" | sed -n 's/.*"method"[ ]*:[ ]*"\([^"]*\)".*/\1/p'; }
STUB_NOTE="MM3 is still being installed (a one-time download of the self-contained build). Its tools appear in this session by themselves when that finishes, usually within a minute."
stub_and_handover() {
  T=$(mktemp -d) || fail "no temp folder"
  mkfifo "$T/in" "$T/rin" "$T/rout" || fail "mkfifo failed"
  exec 6<&0   # a background job's stdin is /dev/null in a non-interactive sh, so hand it the real stdin explicitly
  { cat <&6; echo '{"__mm3":"eof"}'; } > "$T/in" & CATPID=$!
  ( while [ ! -f "$DATA/install.ok" ] && [ ! -f "$DATA/install.err" ] && fetcher_alive; do sleep 1; done
    echo '{"__mm3":"done"}' > "$T/in" ) & WATCHPID=$!
  RPID=; RELAYPID=
  trap 'kill $CATPID $WATCHPID $RPID $RELAYPID 2>/dev/null; rm -rf "$T"' EXIT
  trap 'exit 143' INT TERM HUP
  exec 3< "$T/in"
  INITLINE=; PROTO='2025-06-18'
  say "install is taking longer than the ${WAIT}s start-up allowance: answering Claude Code's handshake now and finishing in the background"
  while IFS= read -r line <&3; do
    case $line in
      *'"__mm3":"eof"'*) exit 0;;
      *'"__mm3":"done"'*) break;;
    esac
    m=$(jmethod "$line"); id=$(jid "$line")
    case $m in
      initialize)
        INITLINE=$line
        p=$(printf '%s' "$line" | sed -n 's/.*"protocolVersion"[ ]*:[ ]*"\([^"]*\)".*/\1/p'); [ -n "$p" ] && PROTO=$p
        printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"%s","capabilities":{"tools":{"listChanged":true}},"serverInfo":{"name":"mm3","version":"installing"},"instructions":"%s"}}\n' "$id" "$PROTO" "$STUB_NOTE";;
      tools/list)
        printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[{"name":"mm3_installing","description":"MM3 is still installing; call this to see its progress. The real mm3 tool replaces this one in a minute.","inputSchema":{"type":"object","properties":{}}}]}}\n' "$id";;
      tools/call)
        got=$(ls -l "$DATA"/*.part.* 2>/dev/null | awk '{s+=$5} END {print int(s/1048576)}')
        printf '{"jsonrpc":"2.0","id":%s,"result":{"content":[{"type":"text","text":"MM3 is still installing (downloaded %s MB so far). Tell the person to wait a minute; do not retry in a loop."}]}}\n' "$id" "${got:-0}";;
      ping) printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id";;
      notifications/*|'') :;;
      *) [ -n "$id" ] && printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"not available while MM3 installs"}}\n' "$id";;
    esac
  done
  if [ -f "$DATA/install.err" ]; then cat "$DATA/fetch.log" >&2; exit 1; fi
  [ -f "$DATA/install.ok" ] || { say "✖ the install stopped without finishing → restart Claude Code to try again (see $DATA/fetch.log)"; exit 1; }
  REAL=$(cat "$DATA/install.ok"); cat "$DATA/fetch.log" >&2
  say "install finished: starting the real MM3 behind this connection"
  "$REAL" mcp < "$T/rin" > "$T/rout" & RPID=$!
  exec 4> "$T/rin"; exec 5< "$T/rout"
  printf '%s\n' "$INITLINE" | sed 's/"id"[ ]*:[ ]*\("[^"]*"\|[0-9][0-9]*\)/"id":"mm3-handover"/' >&4
  IFS= read -r _swallowed <&5          # the real server's initialize reply: the client already has ours
  printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}' >&4
  printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/tools/list_changed"}'
  ( while IFS= read -r l <&5; do printf '%s\n' "$l"; done ) & RELAYPID=$!
  while IFS= read -r line <&3; do
    case $line in *'"__mm3":"eof"'*) break;; *'"__mm3":"done"'*) continue;; esac
    printf '%s\n' "$line" >&4
  done
  exit 0
}

# ---- Windows: Git Bash found `sh`; the fallback is handed to the PowerShell launcher --------------------------
win_delegate() {
  command -v powershell.exe >/dev/null 2>&1 || command -v pwsh >/dev/null 2>&1 || fail "Windows PowerShell not found → install Node.js $MIN_NODE or newer from https://nodejs.org"
  ps1=$HERE/mm3-launch.ps1; command -v cygpath >/dev/null 2>&1 && ps1=$(cygpath -w "$ps1")
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ps1" "$1" "$NODE_WHY"
}

case "$MODE" in
  mcp)
    if node_ok; then exec node "$ROOT/bin/mm3.mjs" mcp; fi
    say "$NODE_WHY. Using the self-contained MM3 build instead."
    [ "$OSK" = win ] && win_delegate mcp
    if installed_ok; then exec "$INSTALLED" mcp; fi
    have_build || no_build
    if [ ! -f "$DATA/install.ok" ] || [ ! -x "$(cat "$DATA/install.ok" 2>/dev/null)" ]; then
      say "it is not installed yet: fetching it once, checking it, installing it. Later starts skip this."
      fetcher_alive || { rm -f "$DATA/install.ok" "$DATA/install.err"; start_fetcher; sleep 1; }
    fi
    n=0
    while [ "$n" -lt "$WAIT" ]; do
      if [ -f "$DATA/install.err" ]; then cat "$DATA/fetch.log" >&2; exit 1; fi
      if [ -f "$DATA/install.ok" ]; then REAL=$(cat "$DATA/install.ok"); cat "$DATA/fetch.log" >&2; next_steps; exec "$REAL" mcp; fi
      fetcher_alive || { n2=0; while [ "$n2" -lt 3 ] && [ ! -f "$DATA/install.ok" ] && [ ! -f "$DATA/install.err" ]; do sleep 1; n2=$((n2+1)); done
        [ -f "$DATA/install.ok" ] || [ -f "$DATA/install.err" ] || { say "✖ the fetch stopped without finishing → restart Claude Code to try again (log: $DATA/fetch.log)"; exit 1; }
        continue; }
      sleep 1; n=$((n + 1))
    done
    stub_and_handover
    ;;
  hook)
    if node_ok noprobe; then exec node "$ROOT/hooks/nudge.mjs"; fi
    if installed_ok; then exec "$INSTALLED" __hook; fi
    cat >/dev/null; exit 0 ;;   # nothing to run yet: the nudge is optional, never an error
  session-start)
    # The one documented way to show the person a message at start-up: JSON `systemMessage` on stdout.
    node_ok && exit 0
    if installed_ok; then
      if [ -f "$DATA/first-run-pending" ]; then
        rm -f "$DATA/first-run-pending"
        printf '{"systemMessage":"MM3 is installed (self-contained build, no Node needed). Next: add your TypeSafe key with /plugin > MM3 > Configure, or run mm3 doctor in a terminal. Without a key MM3 gives sample answers."}\n'
      fi
      exit 0
    fi
    why=$(printf '%s' "$NODE_WHY" | sed 's/"/\\"/g')
    if ! have_build; then
      printf '{"systemMessage":"MM3: %s, and there is no self-contained MM3 build for %s yet. Install Node.js %s or newer from https://nodejs.org and restart Claude Code."}\n' "$why" "$KEY" "$MIN_NODE"
      exit 0
    fi
    [ "$OSK" = win ] || { fetcher_alive || { rm -f "$DATA/install.ok" "$DATA/install.err"; start_fetcher; }; }   # prefetch: starts now, in the background
    printf '{"systemMessage":"MM3: %s. Downloading its self-contained build once (about 100 MB, checked against a checksum pinned in the plugin). MM3 tools appear in this session when it finishes."}\n' "$why"
    exit 0 ;;
  fetch)
    node_ok; installed_ok && exit 0
    fetch_and_install ;;
  *) fail "unknown mode $MODE" ;;
esac
